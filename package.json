{
  "name": "dsh-openjev-browser",
  "description": "DSH cordis plugin: model-driven browser control (OpenJev-4B element picking) with model auto-detection and guided setup.",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "dsh-openjev-browser-setup": "./lib/setup.js"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "setup": "node lib/setup.js",
    "smoke": "node scripts/smoke.mjs",
    "check": "pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "playwright-core": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
